# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# A long, random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# Optional overrides — safe defaults are used if these are left unset.
# DATABASE_PATH=/absolute/path/to/database/legacy_vault.db
# UPLOAD_DIR=/absolute/path/to/uploads
# MAX_UPLOAD_MB=10

# Set to true only on a real deployment (enables secure cookies and
# refuses to start without a real SECRET_KEY).
FLASK_ENV_PRODUCTION=false

# --- Blockchain notarization module (Phase E — optional) ---------------------
# The whole app works without any of this. Leave these blank and document
# notarization simply stays switched off.
#
# Step 22 (wallet & network). Public values only:
#   POLYGON_AMOY_RPC_URL   a public Amoy RPC endpoint. The chain id is 80002.
#                          Default if left blank: https://rpc-amoy.polygon.technology
#   NOTARIZATION_WALLET_ADDRESS
#                          your PUBLIC wallet address (starts with 0x, 42 chars).
#                          This is safe to store. It is NOT a secret.
#
# !! NEVER put your seed phrase (12/24 words) or a private key in this file,
# !! in the app, or anywhere in this project. The app never needs them —
# !! signing happens inside MetaMask in your browser, and only ever asks
# !! you to approve a transaction.
#
# Steps 23-25:
#   NOTARIZATION_CONTRACT_ADDRESS   set after you deploy the contract in Remix.
#                                   Leave blank and notarization stays off.
#
# (No IPFS settings: documents are never uploaded anywhere. Only a fingerprint
#  of each notarized document is recorded, and the file stays in your vault.)
POLYGON_AMOY_RPC_URL=
NOTARIZATION_WALLET_ADDRESS=
NOTARIZATION_CONTRACT_ADDRESS=
